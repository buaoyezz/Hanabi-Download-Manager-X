{
  "manifest_version": 3,
  "name": "Hanabi Download Manager X Extension",
  "version": "1.0.0",
  "description": "HDM X浏览器扩展，用于快速添加下载任务",
  
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "contextMenus",
    "storage"
  ],
  
  "host_permissions": [
    "<all_urls>"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_end"
    }
  ],
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "HDM X下载管理器"
  },
  
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}