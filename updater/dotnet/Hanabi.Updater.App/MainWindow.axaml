<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Hanabi.Updater.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:DataType="vm:UpdaterViewModel"
        d:DesignWidth="720"
        d:DesignHeight="480"
        x:Class="Hanabi.Updater.App.MainWindow"
        Title="{Binding WindowTitleText}"
        Width="720"
        Height="480"
        MinWidth="720"
        MinHeight="480"
        MaxWidth="720"
        MaxHeight="480"
        CanResize="False"
        WindowDecorations="None"
        Icon="/Assets/logo.ico"
        Closing="OnWindowClosing"
        TransparencyLevelHint="Mica, AcrylicBlur"
        TransparencyBackgroundFallback="{DynamicResource WindowFallbackBg}"
        Background="Transparent">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="LetterSpacing" Value="0" />
        </Style>

        <Style Selector="Button">
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.09" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.motion">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.09" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.motion:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.015)" />
        </Style>

        <Style Selector="Button.motion:pressed">
            <Setter Property="RenderTransform" Value="scale(0.975)" />
            <Setter Property="Opacity" Value="0.84" />
        </Style>

        <Style Selector="Button.titleButton">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TitleBtnFg}" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.titleButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource TitleBtnHoverBg}" />
        </Style>

        <Style Selector="Button.closeButton:pointerover">
            <Setter Property="Background" Value="#C42B1C" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style Selector="Button.heroButton">
            <Setter Property="Width" Value="232" />
            <Setter Property="Height" Value="42" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.heroButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        </Style>

        <Style Selector="Button.primaryButton">
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.primaryButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        </Style>

        <Style Selector="Button.primaryButton:disabled">
            <Setter Property="Background" Value="{DynamicResource PrimaryBtnDisabledBg}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBtnDisabledFg}" />
        </Style>

        <Style Selector="Button.secondaryButton">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.secondaryButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceSubtle}" />
        </Style>

        <Style Selector="Button.ghostButton">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="Button.ghostButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceSubtle}" />
        </Style>

        <Style Selector="Border.navItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.navItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource NavigationItemHoverBg}" />
        </Style>

        <Style Selector="Button.navButton">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style Selector="Button.navButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource NavigationItemHoverBg}" />
        </Style>

        <Style Selector="Button.browseButton">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="{DynamicResource SurfaceSubtle}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="Button.browseButton:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style Selector="ProgressBar">
            <Setter Property="Height" Value="7" />
            <Setter Property="Background" Value="{DynamicResource ProgressBg}" />
            <Setter Property="Foreground" Value="{DynamicResource ProgressFg}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Value" Duration="0:0:0.24" />
                </Transitions>
            </Setter>
        </Style>
    </Window.Styles>

    <Border Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid RowDefinitions="40,*">
            <Border Grid.Row="0"
                    Background="{DynamicResource WindowBg}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Orientation="Horizontal"
                                Spacing="9"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                        <Image Source="/Assets/logo.png" Width="19" Height="19" Stretch="Uniform" />
                        <TextBlock Text="{Binding ShellTitleText}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Classes="titleButton"
                                Content="&#xE706;"
                                IsEnabled="{Binding CanAdjustPreferences}"
                                ToolTip.Tip="切换明暗主题 / Theme"
                                Click="OnThemeToggleClick" />
                        <Button Classes="titleButton"
                                Content="&#xE8C1;"
                                IsEnabled="{Binding CanAdjustPreferences}"
                                ToolTip.Tip="切换语言 / Language"
                                Click="OnLangToggleClick" />
                        <Button Classes="titleButton"
                                Content="&#xE921;"
                                FontSize="11"
                                ToolTip.Tip="最小化 / Minimize"
                                Click="OnMinimizeClick" />
                        <Button Classes="titleButton closeButton"
                                Content="&#xE8BB;"
                                FontSize="11"
                                ToolTip.Tip="关闭 / Close"
                                Click="OnCloseClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Background="{DynamicResource ContentBg}"
                  IsVisible="{Binding IsWelcomeVisible}"
                  RowDefinitions="*,Auto">
                <StackPanel x:Name="WelcomeContent"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,-8,0,0">
                    <Image Source="/Assets/logo.png"
                           Width="128"
                           Height="104"
                           Stretch="Uniform"
                           HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding SetupTitleText}"
                               Margin="0,20,0,0"
                               FontSize="28"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding SetupSubtitleText}"
                               Margin="0,8,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center" />
                    <Button Classes="heroButton motion"
                            Margin="0,28,0,0"
                            HorizontalAlignment="Center"
                            Click="OnStartButtonClick">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <TextBlock Text="{Binding StartInstallText}"
                                       Foreground="{DynamicResource AccentForegroundBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="&#xE72A;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                       Foreground="{DynamicResource AccentForegroundBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Grid.Row="1"
                           Text="{Binding SetupVersionText}"
                           Margin="0,0,0,18"
                           FontSize="11"
                           Foreground="{DynamicResource TextMuted}"
                           HorizontalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="1"
                  ColumnDefinitions="190,*"
                  IsVisible="{Binding IsMainContentVisible}">
                <Border Grid.Column="0"
                        Background="{DynamicResource NavigationPaneBg}"
                        BorderBrush="{DynamicResource NavigationPaneBorder}"
                        BorderThickness="0,0,1,0">
                    <Grid RowDefinitions="Auto,*,Auto" Margin="8,14,8,10">
                        <TextBlock Text="{Binding StepProgressText}"
                                   Margin="10,2,0,0"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMuted}" />

                        <ItemsControl Grid.Row="1"
                                      ItemsSource="{Binding Steps}"
                                      Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StepItem">
                                    <Border Classes="navItem"
                                            Height="40"
                                            Margin="0,0,0,2"
                                            CornerRadius="4">
                                        <Grid>
                                            <Border Background="{DynamicResource NavigationItemSelectedBg}"
                                                    CornerRadius="4"
                                                    Opacity="{Binding SelectionOpacity}">
                                                <Border.Transitions>
                                                    <Transitions>
                                                        <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                                                    </Transitions>
                                                </Border.Transitions>
                                            </Border>
                                            <Border Width="3"
                                                    Height="16"
                                                    CornerRadius="2"
                                                    Background="{DynamicResource AccentBrush}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Opacity="{Binding SelectionOpacity}">
                                                <Border.Transitions>
                                                    <Transitions>
                                                        <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                                                    </Transitions>
                                                </Border.Transitions>
                                            </Border>
                                            <Grid ColumnDefinitions="34,*" Margin="10,0,8,0">
                                                <TextBlock Text="{Binding Indicator}"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                                           FontSize="15"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           IsVisible="{Binding IsPending}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding Indicator}"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                                           FontSize="15"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           IsVisible="{Binding IsActive}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding Indicator}"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                                           FontSize="15"
                                                           Foreground="{DynamicResource SuccessBrush}"
                                                           IsVisible="{Binding IsDone}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Label}"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           IsVisible="{Binding IsPending}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Label}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           IsVisible="{Binding IsActive}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Label}"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           IsVisible="{Binding IsDone}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Grid.Row="2" RowDefinitions="Auto,Auto">
                            <Button Classes="navButton"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="{Binding CanAdjustPreferences}"
                                    ToolTip.Tip="{Binding AboutToolTipText}"
                                    Click="OnAboutClick">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="&#xE946;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                               FontSize="15"
                                               Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding AboutText}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding SetupVersionText}"
                                       Margin="12,5,0,0"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextMuted}" />
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Column="1"
                      RowDefinitions="*,60"
                      Background="{DynamicResource ContentBg}">
                    <Grid x:Name="PageHost" Margin="32,26,32,0">
                        <StackPanel IsVisible="{Binding IsLicenseVisible}">
                            <TextBlock Text="{Binding Title}" Classes="pageTitle" />
                            <TextBlock Text="{Binding Description}"
                                       Classes="muted"
                                       Margin="0,5,0,0" />

                            <Border Height="218"
                                    Background="{DynamicResource SurfaceBg}"
                                    BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="15"
                                    Margin="0,18,0,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding LicenseText}"
                                               FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                               FontSize="10.5"
                                               LineHeight="17"
                                               Foreground="{DynamicResource TextSecondary}"
                                               TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Border>

                            <CheckBox Content="{Binding AcceptLicenseText}"
                                      IsChecked="{Binding LicenseAccepted}"
                                      Margin="0,13,0,0" />
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsLocationVisible}">
                            <TextBlock Text="{Binding Title}" Classes="pageTitle" />
                            <TextBlock Text="{Binding Description}"
                                       Classes="muted"
                                       Margin="0,5,0,0" />

                            <Border Background="{DynamicResource SurfaceBg}"
                                    BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="16"
                                    Margin="0,22,0,0">
                                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12">
                                    <Border Width="34"
                                            Height="34"
                                            CornerRadius="6"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            Grid.RowSpan="2">
                                        <TextBlock Text="&#xE8B7;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TargetDirText}"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1"
                                               Grid.Row="1"
                                               Text="{Binding InstallLocation}"
                                               FontSize="12"
                                               Margin="0,3,0,0"
                                               Foreground="{DynamicResource TextSecondary}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="2"
                                            Grid.RowSpan="2"
                                            Classes="browseButton motion"
                                            Content="{Binding ChangeDirText}"
                                            VerticalAlignment="Center"
                                            Click="OnBrowseClick" />
                                    <TextBlock Grid.Column="1"
                                               Grid.Row="2"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding InstallLocationStatusText}"
                                               FontSize="11"
                                               Margin="0,10,0,0"
                                               Foreground="{DynamicResource TextMuted}" />
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource InfoSoftBrush}"
                                    CornerRadius="6"
                                    Padding="13,11"
                                    Margin="0,12,0,0">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <TextBlock Text="&#xE72E;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                               FontSize="14"
                                               Foreground="{DynamicResource InfoBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding LocationWarningText}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource SurfaceBg}"
                                    BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="13,10"
                                    Margin="0,12,0,0">
                                <CheckBox Content="{Binding AccelerationNodeText}"
                                          IsChecked="{Binding UseAccelerationNode}" />
                            </Border>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsProgressVisible}">
                            <TextBlock Text="{Binding Title}" Classes="pageTitle" />
                            <TextBlock Text="{Binding Description}"
                                       Classes="muted"
                                       Margin="0,5,0,0"
                                       TextWrapping="Wrap" />

                            <Grid ColumnDefinitions="*,Auto" Margin="0,30,0,0">
                                <TextBlock Text="{Binding InstallProgressText}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Bottom" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding PercentText}"
                                           FontSize="28"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Bottom" />
                            </Grid>
                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Value="{Binding Percent}"
                                         IsIndeterminate="{Binding IsProgressIndeterminate}"
                                         Margin="0,10,0,0" />

                            <Border Background="{DynamicResource SurfaceBg}"
                                    BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="16"
                                    Margin="0,24,0,0">
                                <Grid ColumnDefinitions="36,*" ColumnSpacing="12">
                                    <Border Width="34"
                                            Height="34"
                                            CornerRadius="6"
                                            Background="{DynamicResource AccentSoftBrush}">
                                        <TextBlock Text="&#xE896;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Detail}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondary}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Button Classes="ghostButton"
                                    Content="{Binding SkipText}"
                                    IsVisible="{Binding IsSkipVisible}"
                                    HorizontalAlignment="Right"
                                    Margin="0,10,0,0"
                                    Click="OnSkipClick" />
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsDoneVisible}"
                                    Width="390"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,-8,0,0">
                            <Border Width="58"
                                    Height="58"
                                    CornerRadius="29"
                                    Background="{DynamicResource SuccessSoftBrush}"
                                    IsVisible="{Binding IsSuccessResult}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="&#xE73E;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                           FontSize="24"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Border Width="58"
                                    Height="58"
                                    CornerRadius="29"
                                    Background="{DynamicResource ErrorSoftBrush}"
                                    IsVisible="{Binding IsFailureResult}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="&#xE783;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                           FontSize="24"
                                           Foreground="{DynamicResource ErrorBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding ResultLabelText}"
                                       Margin="0,16,0,0"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMuted}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Title}"
                                       Margin="0,5,0,0"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Description}"
                                       Margin="0,7,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center" />
                            <Border Background="{DynamicResource SurfaceBg}"
                                    BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="14,11"
                                    Margin="0,18,0,0">
                                <TextBlock Text="{Binding Detail}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="{DynamicResource CommandBarBg}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="32,0">
                            <Button Grid.Column="0"
                                    Classes="secondaryButton motion"
                                    Content="{Binding SecondaryButtonText}"
                                    IsVisible="{Binding IsSecondaryButtonVisible}"
                                    Click="OnSecondaryButtonClick" />
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="12,0,0,0"
                                        IsVisible="{Binding IsFooterStatusVisible}">
                                <TextBlock Text="&#xE946;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMuted}" />
                                <TextBlock Text="{Binding FooterStatusText}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMuted}" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Classes="primaryButton motion"
                                    Content="{Binding PrimaryButtonText}"
                                    IsVisible="{Binding IsPrimaryButtonVisible}"
                                    IsEnabled="{Binding CanUsePrimaryButton}"
                                    Click="OnPrimaryButtonClick" />
                            <Button Grid.Column="2"
                                    Classes="secondaryButton motion"
                                    Content="{Binding PrimaryButtonText}"
                                    IsVisible="{Binding IsCancelButtonVisible}"
                                    Click="OnPrimaryButtonClick" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Row="1"
                  Background="{DynamicResource ContentBg}"
                  IsVisible="{Binding IsAboutVisibleOverlay}">
                <StackPanel x:Name="AboutContent"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="380"
                            Margin="0,-8,0,0">
                    <Border Width="76"
                            Height="76"
                            CornerRadius="8"
                            Background="{DynamicResource AccentSoftBrush}"
                            HorizontalAlignment="Center">
                        <Image Source="/Assets/logo.png"
                               Width="56"
                               Height="56"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Hanabi Download Manager X"
                               Margin="0,17,0,0"
                               FontSize="22"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding SetupVersionText}"
                               Margin="0,5,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextMuted}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding SpecialThanksText}"
                               Margin="0,18,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondary}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="© 2026 ZZBuAoYe. All rights reserved."
                               Margin="0,7,0,0"
                               FontSize="10"
                               Foreground="{DynamicResource TextMuted}"
                               HorizontalAlignment="Center" />
                    <Button Classes="secondaryButton motion"
                            Content="{Binding BackText}"
                            HorizontalAlignment="Center"
                            Margin="0,22,0,0"
                            Click="OnAboutClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
