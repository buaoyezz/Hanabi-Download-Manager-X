#include "resource.h"
#include "winver.h"

#ifdef FLUTTER_VERSION_MAJOR
#define VERSION_AS_NUMBER FLUTTER_VERSION_MAJOR,FLUTTER_VERSION_MINOR,FLUTTER_VERSION_PATCH,FLUTTER_VERSION_BUILD
#else
#define VERSION_AS_NUMBER 1,0,0,0
#endif

#ifdef FLUTTER_VERSION
#define VERSION_AS_STRING FLUTTER_VERSION
#else
#define VERSION_AS_STRING "1.0.0"
#endif

IDI_APP_ICON ICON "resources\\app_icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VERSION_AS_NUMBER
PRODUCTVERSION  VERSION_AS_NUMBER
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            VALUE "CompanyName",      "ZZBuAoYe" "\0"
            VALUE "FileDescription",  "Hanabi Download ManagerX" "\0"
            VALUE "FileVersion",      VERSION_AS_STRING "\0"
            VALUE "InternalName",     "HanabiDownloadManagerX" "\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 ZZBuAoYe" "\0"
            VALUE "OriginalFilename", "HanabiDownloadManagerX.exe" "\0"
            VALUE "ProductName",      "Hanabi Download ManagerX" "\0"
            VALUE "ProductVersion",   VERSION_AS_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
